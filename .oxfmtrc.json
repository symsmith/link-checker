{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "sortImports": {
    "newlinesBetween": true,
    "order": "asc"
  },
  "jsdoc": {
    "capitalizeDescriptions": true,
    "commentLineStrategy": "singleLine",
    "lineWrappingStyle": "greedy"
  },
  "ignorePatterns": ["pnpm-lock.yaml"]
}
